# Copy this file to guardian.env (same folder) and fill it in. guardian.env is never uploaded to GitHub.
# Get the key and secret from ICICI's Breeze API portal (see GUARDIAN.md). Never share them.
BREEZE_API_KEY=
BREEZE_API_SECRET=
# Changes every day: run "python backend/guardian.py login" and paste the apisession value here.
BREEZE_SESSION_TOKEN=

# paper = alerts only (default). live = may exit positions, and ALSO needs "--live" on the command line.
MODE=paper

# Free phone alerts: install the "ntfy" app and subscribe to a long, random topic name you make up.
NTFY_TOPIC=

POLL_SECONDS=20
MAX_DAILY_ORDERS=12
TRAIL_PCT=25

# Phone commands (from the Trade Desk app's Live tab, or the ntfy app). Use a DIFFERENT long random
# topic from NTFY_TOPIC, and a PIN of at least 6 characters. Anyone with both could send commands.
NTFY_CMD_TOPIC=
GUARDIAN_PIN=
# Most lots one ENTER command may place
MAX_LOTS=1

# Starts the GitHub engine runs on time from this server (server/install-cron.sh).
# Fine-grained GitHub token: only the nse-engine repo, permission "Actions: Read and write".
GITHUB_TOKEN=
